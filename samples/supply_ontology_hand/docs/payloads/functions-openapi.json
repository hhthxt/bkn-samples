  "components": {
    "schemas": {
      "BackwardPlanRequest": {
        "properties": {
          "resolved_context": {
            "$ref": "#/components/schemas/ResolvedContextRequest"
          },
          "product": {
            "type": "string",
            "title": "Product",
            "description": "产品编码"
          },
          "forecast_id": {
            "type": "string",
            "title": "Forecast Id",
            "description": "单张需求预测单 ID"
          },
          "demand_end": {
            "type": "string",
            "title": "Demand End",
            "description": "需求截止日 YYYY-MM-DD"
          },
          "demand_qty": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Demand Qty",
            "description": "需求数量，须与预测单一致"
          },
          "warehouse_scope": {
            "title": "Warehouse Scope",
            "description": "仓范围预设 production_available/finished_goods/all，或显式仓列表",
            "default": "production_available",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "substitute_enabled": {
            "type": "boolean",
            "title": "Substitute Enabled",
            "description": "必须明确是否启用替代料"
          },
          "report_grain": {
            "type": "string",
            "title": "Report Grain",
            "description": "summary 或 full_tree",
            "default": "summary"
          }
        },
        "type": "object",
        "required": [
          "resolved_context",
          "product",
          "forecast_id",
          "demand_end",
          "demand_qty",
          "substitute_enabled"
        ],
        "title": "BackwardPlanRequest"
      },
      "BomListRequest": {
        "properties": {
          "resolved_context": {
            "$ref": "#/components/schemas/ResolvedContextRequest"
          },
          "product": {
            "type": "string",
            "title": "Product",
            "description": "产品编码"
          },
          "depth": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Depth",
            "description": "展开层数；null 表示全层级",
            "default": 1
