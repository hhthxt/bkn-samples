          "demands": {
            "items": {
              "$ref": "#/components/schemas/Demand"
            },
            "type": "array",
            "minItems": 2,
            "title": "Demands",
            "description": "至少两条需求；数组顺序即扣减顺序"
          },
          "warehouse_scope": {
            "title": "Warehouse Scope",
            "description": "生产可用仓范围",
            "default": "production_available",
            "anyOf": [
              {
                "type": "string"
              },
