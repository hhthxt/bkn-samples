{
  "openapi": "3.0.3",
  "info": {
    "title": "供应链受控行动工具箱",
    "version": "0.1.0",
    "description": "仅接受人工批准凭证的本地 dry-run Action Gateway；不连接 ERP。"
  },
  "servers": [{"url": "http://host.docker.internal:8766"}],
  "paths": {
    "/actions/create_monitor_task": {
      "post": {
        "operationId": "create_monitor_task",
        "summary": "创建计划协同监控任务",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ActionRequest"}}}},
        "responses": {"200": {"description": "Dry-run action receipt", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}}}
      }
    },
    "/actions/create_pr_decision": {
      "post": {
        "operationId": "create_pr_decision",
        "summary": "创建采购申请决策",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ActionRequest"}}}},
        "responses": {"200": {"description": "Dry-run action receipt", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}}}
      }
    },
    "/actions/close_monitor_task": {
      "post": {
        "operationId": "close_monitor_task",
        "summary": "关闭计划协同监控任务",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ActionRequest"}}}},
        "responses": {"200": {"description": "Dry-run action receipt", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}}}
      }
    }
  },
  "components": {
    "schemas": {
      "ActionRequest": {
        "type": "object",
        "required": ["proposal", "approval_token"],
        "properties": {
          "proposal": {"type": "object", "additionalProperties": true},
          "approval_token": {"type": "string", "description": "人工批准凭证；Agent 不得自行签发。"}
        }
      }
    }
  }
}
