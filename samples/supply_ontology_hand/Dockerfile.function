FROM python:3.11-slim

WORKDIR /app

COPY tools/requirements.txt /app/tools/requirements.txt
RUN pip install --no-cache-dir -r /app/tools/requirements.txt

COPY tools /app/tools
ENV PYTHONPATH=/app/tools

EXPOSE 8765

HEALTHCHECK --interval=10s --timeout=3s --retries=10 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/health', timeout=2)"

CMD ["uvicorn", "fn_service:app", "--app-dir", "/app/tools", "--host", "0.0.0.0", "--port", "8765"]
